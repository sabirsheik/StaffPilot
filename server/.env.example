NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=6d
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
CLIENT_URL=https://your-frontend.example.com
# Optional durable path for uploaded files
# UPLOADS_DIR=/var/lib/staffpilot/uploads
